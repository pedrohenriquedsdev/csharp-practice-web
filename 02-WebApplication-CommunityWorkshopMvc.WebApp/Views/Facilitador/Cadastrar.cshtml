@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Facilitador";
}

@model CadastrarFacilitadorViewModel;

<form class="formulario" asp-action="Cadastrar" method="post">

    <div class="formulario-campo">
        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" type="text">
        <span asp-validation-for="Nome" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email">
        <span asp-validation-for="Email" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="Especialidade">Especialidade</label>
        <input asp-for="Especialidade" type="text">
        <span asp-validation-for="Especialidade" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-acoes">
        <a asp-action="Listar">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>
</form>