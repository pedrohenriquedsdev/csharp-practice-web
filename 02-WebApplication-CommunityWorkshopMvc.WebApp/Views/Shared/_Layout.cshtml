<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gestão de Oficinas</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Gestão de Oficinas
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Facilitador" asp-action="Listar">
                                Facilitadores
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participante" asp-action="Listar">
                                Participantes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Oficina" asp-action="Listar">
                                Oficinas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inscricao" asp-action="Listar">
                                Inscrições
                            </a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>

    <main class="container mt-4">

        @RenderBody()

    </main>

    <footer class="border-top mt-5 py-3 text-center text-muted">
        <small>
            Gestão de Oficinas Criativas Comunitárias
        </small>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>