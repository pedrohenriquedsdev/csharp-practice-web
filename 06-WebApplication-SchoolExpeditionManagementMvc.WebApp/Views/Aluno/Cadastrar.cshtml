@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastrar Aluno";
}

@model CadastrarAlunoViewModel

<div class="card border-0 shadow-sm formulario">

    <form asp-action="Cadastrar" method="post">

        <div class="mb-3">

            <label asp-for="Nome" class="form-label fw-semibold">
                Nome
            </label>

            <input asp-for="Nome" class="form-control" placeholder="Ex: João Silva">

            <span asp-validation-for="Nome" class="text-danger"></span>

        </div>


        <div class="mb-3">

            <label asp-for="NomeResponsavel" class="form-label fw-semibold">
                Nome do responsável
            </label>

            <input asp-for="NomeResponsavel" class="form-control" placeholder="Ex: Maria Silva">

            <span asp-validation-for="NomeResponsavel" class="text-danger"></span>

        </div>


        <div class="mb-3">

            <label asp-for="Telefone" class="form-label fw-semibold">
                Telefone
            </label>

            <input asp-for="Telefone" class="form-control" placeholder="Ex: 49999999999">

            <span asp-validation-for="Telefone" class="text-danger"></span>

        </div>


        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Listar" class="btn btn-outline-secondary">
                Voltar
            </a>

            <button type="submit" class="btn btn-primary">
                Salvar
            </button>

        </div>

    </form>

</div>