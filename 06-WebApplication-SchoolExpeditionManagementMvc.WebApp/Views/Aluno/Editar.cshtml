@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Aluno";
}

@model EditarAlunoViewModel

<div class="card border-0 shadow-sm formulario">

    <form asp-action="Editar" method="post">

        <input asp-for="Id" type="hidden">


        <div class="mb-3">

            <label asp-for="Nome" class="form-label fw-semibold">
                Nome
            </label>

            <input asp-for="Nome" class="form-control">

            <span asp-validation-for="Nome" class="text-danger"></span>

        </div>


        <div class="mb-3">

            <label asp-for="NomeResponsavel" class="form-label fw-semibold">
                Nome do responsável
            </label>

            <input asp-for="NomeResponsavel" class="form-control">

            <span asp-validation-for="NomeResponsavel" class="text-danger"></span>

        </div>


        <div class="mb-3">

            <label asp-for="Telefone" class="form-label fw-semibold">
                Telefone
            </label>

            <input asp-for="Telefone" class="form-control">

            <span asp-validation-for="Telefone" class="text-danger"></span>

        </div>


        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Listar" class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button class="btn btn-primary" type="submit">
                Atualizar
            </button>

        </div>

    </form>

</div>