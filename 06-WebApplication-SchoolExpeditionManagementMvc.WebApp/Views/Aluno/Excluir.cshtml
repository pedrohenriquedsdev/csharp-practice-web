@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Aluno";
}

@model ExcluirAlunoViewModel

<div class="card border-0 shadow-sm formulario">

    <form asp-action="Excluir" method="post">

        <input asp-for="Id" type="hidden">


        <div class="alert alert-warning">

            Deseja realmente excluir este aluno?

        </div>


        <div class="mb-3">

            <label asp-for="Nome" class="form-label fw-semibold">
                Nome
            </label>

            <input asp-for="Nome" class="form-control" disabled>

        </div>


        <div class="mb-3">

            <label asp-for="NomeResponsavel" class="form-label fw-semibold">
                Nome do responsável
            </label>

            <input asp-for="NomeResponsavel" class="form-control" disabled>

        </div>


        <div class="mb-3">

            <label asp-for="Telefone" class="form-label fw-semibold">
                Telefone
            </label>

            <input asp-for="Telefone" class="form-control" disabled>

        </div>


        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Listar" class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit" class="btn btn-danger">
                Excluir
            </button>

        </div>


    </form>

</div>