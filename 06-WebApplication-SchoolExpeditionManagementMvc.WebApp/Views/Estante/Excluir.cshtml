@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Estante";
}

@model ExcluirEstanteViewModel


<div class="card border-0 shadow-sm formulario">


    <form asp-action="Excluir" method="post">


        <input asp-for="Id" type="hidden">



        <div class="alert alert-warning">

            Deseja realmente excluir esta estante?

        </div>



        <div class="mb-3">


            <label asp-for="Codigo" class="form-label fw-semibold">
                Código
            </label>


            <input asp-for="Codigo" class="form-control" disabled>


        </div>



        <div class="mb-3">


            <label asp-for="Cor" class="form-label fw-semibold">
                Cor
            </label>


            <input asp-for="Cor" class="form-control" disabled>


        </div>




        <div class="mb-3">


            <label asp-for="DiasEmprestimo" class="form-label fw-semibold">
                Dias de empréstimo
            </label>


            <input asp-for="DiasEmprestimo" class="form-control" disabled>


        </div>




        <div class="d-flex justify-content-end gap-2">


            <a asp-action="Listar" class="btn btn-outline-secondary">
                Cancelar
            </a>


            <button type="submit" class="btn btn-danger">
                Excluir
            </button>


        </div>



    </form>


</div>