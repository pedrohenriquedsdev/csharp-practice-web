@{
    Layout = "_Layout";
    ViewBag.Titulo = "Estantes";
}

@model List<ListarEstanteViewModel>


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h3 class="fw-bold mb-1">
            Estantes cadastradas
        </h3>

        <p class="text-muted mb-0">
            Gerencie as estantes disponíveis na biblioteca.
        </p>
    </div>


    <a class="btn-cadastrar" asp-action="Cadastrar">
        + Nova Estante
    </a>

</div>



@if (Model.Count == 0)
{
    <div class="alert alert-light border shadow-sm">

        Nenhuma estante cadastrada.

    </div>
}
else
{

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">


            <div class="table-responsive">

                <table class="table table-hover mb-0">


                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>Código</th>
                            <th>Cor</th>
                            <th>Dias de Empréstimo</th>
                            <th class="text-end">Ações</th>
                        </tr>

                    </thead>


                    <tbody>


                        @foreach (ListarEstanteViewModel e in Model)
                        {

                            <tr>

                                <td>
                                    <small class="text-muted">
                                        @e.Id
                                    </small>
                                </td>


                                <td class="fw-semibold">
                                    @e.Codigo
                                </td>


                                <td>
                                    @e.Cor
                                </td>


                                <td>
                                    @e.DiasEmprestimo dias
                                </td>


                                <td class="text-end">


                                    <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@e.Id">
                                        Editar
                                    </a>


                                    <a class="btn btn-sm btn-outline-danger" asp-action="Excluir" asp-route-id="@e.Id">
                                        Excluir
                                    </a>


                                </td>


                            </tr>

                        }


                    </tbody>


                </table>


            </div>


        </div>

    </div>

}