@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Estantes";
}

@model List<ListarEstanteViewModel>

<a class="btn-cadastrar" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <p class="formulario-alerta">Nenhuma estante cadastrada.</p>
}
else
{
    <table class="registros">
        <thead>
            <tr>
                <th>ID</th>
                <th>Codigo</th>
                <th>Cor</th>
                <th>Dias de Emprestimo</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ListarEstanteViewModel e in Model)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.Codigo</td>
                    <td>@e.Cor</td>
                    <td>@e.DiasEmprestimo</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@e.Id">Editar</a>
                        <a asp-action="Excluir" asp-route-id="@e.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}