@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Livro";
}

@model EditarLivroViewModel


<div class="card border-0 shadow-sm formulario">

    <form asp-action="Editar" method="post">


        <input asp-for="Id" type="hidden">


        <div class="mb-3">

            <label asp-for="Titulo" class="form-label fw-semibold">
                Título
            </label>

            <input asp-for="Titulo" class="form-control">

            <span asp-validation-for="Titulo" class="text-danger">
            </span>

        </div>



        <div class="mb-3">

            <label asp-for="NumeroEdicao" class="form-label fw-semibold">
                Número da edição
            </label>

            <input asp-for="NumeroEdicao" class="form-control" type="number">

            <span asp-validation-for="NumeroEdicao" class="text-danger">
            </span>

        </div>



        <div class="mb-3">

            <label asp-for="DataPublicacao" class="form-label fw-semibold">
                Data de publicação
            </label>

            <input asp-for="DataPublicacao" class="form-control" type="date">

            <span asp-validation-for="DataPublicacao" class="text-danger">
            </span>

        </div>



        <div class="mb-3">

            <label asp-for="EstanteId" class="form-label fw-semibold">
                Estante
            </label>

            <select asp-for="EstanteId" class="form-select" asp-items="ViewBag.Estantes">

                <option value="">
                    Selecione uma estante
                </option>

            </select>

            <span asp-validation-for="EstanteId" class="text-danger">
            </span>

        </div>



        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Listar" class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit" class="btn btn-primary">
                Atualizar
            </button>

        </div>


    </form>

</div>