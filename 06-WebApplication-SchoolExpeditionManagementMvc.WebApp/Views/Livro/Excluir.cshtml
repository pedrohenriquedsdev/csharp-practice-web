@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Livro";
}

@model ExcluirLivroViewModel


<div class="card border-0 shadow-sm formulario">


    <form asp-action="Excluir" method="post">


        <input asp-for="Id" type="hidden">



        <div class="alert alert-warning">

            Deseja realmente excluir este livro?

        </div>



        <div class="mb-3">

            <label asp-for="Titulo" class="form-label fw-semibold">
                Título
            </label>

            <input asp-for="Titulo" class="form-control" disabled>

        </div>



        <div class="mb-3">

            <label asp-for="NumeroEdicao" class="form-label fw-semibold">
                Número da edição
            </label>

            <input asp-for="NumeroEdicao" class="form-control" disabled>

        </div>



        <div class="mb-3">

            <label asp-for="DataPublicacao" class="form-label fw-semibold">
                Data de publicação
            </label>

            <input asp-for="DataPublicacao" class="form-control" disabled>

        </div>



        <div class="mb-3">

            <label asp-for="Estante" class="form-label fw-semibold">
                Estante
            </label>

            <input asp-for="Estante" class="form-control" disabled>

        </div>



        <div class="mb-3">

            <label asp-for="Status" class="form-label fw-semibold">
                Status
            </label>

            <input asp-for="Status" class="form-control" disabled>

        </div>



        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Listar" class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit" class="btn btn-danger">
                Excluir
            </button>

        </div>


    </form>


</div>